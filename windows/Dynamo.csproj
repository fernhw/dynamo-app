<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- allows building the Windows exe from macOS/Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Dynamo</AssemblyName>
    <RootNamespace>Dynamo</RootNamespace>
    <ApplicationIcon>Dynamo.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Dynamo</Product>
    <Description>DYNAMO — screenplay editor for videogames</Description>
    <Version>1.0.0</Version>

    <!-- one portable Dynamo.exe: no .NET install, no installer -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../web/**" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- exe icon resource is only stamped when building ON Windows; window icon comes from here -->
    <EmbeddedResource Include="Dynamo.ico" LogicalName="Dynamo.ico" />
    <EmbeddedResource Include="bridge.js" LogicalName="bridge-win.js" />
  </ItemGroup>

</Project>
